<p style="color: green"><%= notice %></p>

<% content_for :title, "Expenses" %>

<h1>Expenses</h1>

<div id="expenses">
  <table>
    <tr>
      <th>Reg.nro.</th>
      <th>Date</th>
      <th>Title</th>
      <th>Price</th>
      <th></th>
    </tr>
  <% @expenses.each do |expense| %>
    <tr>
      <td><%= expense.regnro %></td>
      <td><%= expense.date %></td>
      <td><%= expense.title %></td>
      <td><%= number_to_currency(expense.price, :unit => "€", :separator => ",") %></td>
      <td><%= link_to "Show this expense", expense %></td>
    </tr>
  <% end %>
</div>

<%= link_to "New expense", new_expense_path %>
